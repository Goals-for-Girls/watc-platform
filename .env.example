# Where "Report a concern" sends people. Must be a monitored safeguarding
# inbox owned by Goals for Girls. Leave unset and the site shows a clear
# placeholder instead of a broken link.
NEXT_PUBLIC_SAFEGUARDING_EMAIL=

# Anthropic API key for the bot demo, from a Goals for Girls Anthropic Console
# account. Set it in Vercel (Settings > Environment Variables), never in code.
# Leave unset and the bot runs in offline mode with simple keyword rules.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (fast and low cost).
ANTHROPIC_MODEL=
